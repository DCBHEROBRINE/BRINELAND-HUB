local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- CONFIGURATION
local GET_KEY_URL = "https://pandauth.com/getkey/brineland" -- Replace with your Get Key link
local SERVICE_ID  = "YOUR_PANDA_AUTH_SERVICE_ID"          -- Replace with your Service ID

-- Check if Key is Already Saved Locally
local keyFileName = "BrinelandKey.txt"
local savedKey = isfile and isfile(keyFileName) and readfile(keyFileName) or ""

-- Function to Verify Key Against Server API
local function VerifyKey(userKey)
    if userKey == "" then return false end

    -- Panda Auth API Endpoint
    local apiURL = string.format("https://api.pandauth.com/v1/verify?service_id=%s&key=%s", SERVICE_ID, userKey)
    
    local success, response = pcall(function()
        return game:HttpGet(apiURL)
    end)

    if success and response then
        local data = pcall(function() return HttpService:JSONDecode(response) end) and HttpService:JSONDecode(response) or {}
        if data.valid == true or data.status == "success" then
            if writefile then writefile(keyFileName, userKey) end -- Save key locally
            return true
        end
    end
    return false
end

-- Function to Launch Main Hub
local function StartMainHub()
    print("[BRINELAND] Key Verified! Launching Hub...")
    -- Load your main script file
    loadstring(game:HttpGet("https://raw.githubusercontent.com/DCBHEROBRINE/BRINELAND-HUB/main/main.lua"))()
end

-- Auto-verify saved key
if VerifyKey(savedKey) then
    StartMainHub()
    return
end

