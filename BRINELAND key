    if VerifyKey(userKey) then
        KeyGui:Destroy()
        StartMainHub()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        StatusLabel.Text = "Invalid or Expired Key!"
    end
end)

-- Get Key Link Action
